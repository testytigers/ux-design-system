{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "paths": {
      "@ux/tokens": ["../tokens/src"],
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "noEmitOnError": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "scripts"]
}
